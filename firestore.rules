rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Usuário logado (balcão ou admin)
    function isSignedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && userProfile().perfil == 'admin';
    }

    // Perfil legado: sem doc em /usuarios, o app trata como admin
    function isLegacyAdmin() {
      return isSignedIn()
        && !exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function canManageUsers() {
      return isAdmin() || isLegacyAdmin();
    }

    // --- USUÁRIOS (login / perfil) ---
    match /usuarios/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || canManageUsers());
      allow create: if canManageUsers();
      allow update, delete: if canManageUsers();
    }

    // --- CLIENTES ---
    // Staff: acesso total. Link remoto (?cliente=ID): só leitura do doc e grava assinatura em itens.
    match /clientes/{clientId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() || request.auth == null;
      allow create, delete: if isSignedIn();
      allow update: if isSignedIn() || (
        request.auth == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['itens'])
      );
    }

    // --- CATÁLOGO DE PEÇAS ---
    match /catalogo/{docId} {
      allow read, write: if isSignedIn();
    }

    // --- CONFIG EMPRESA / LOGO ---
    match /config/{docId} {
      allow read, write: if isSignedIn();
    }

    // --- VENDAS / SAÍDAS (vendas.html) — só admin ---
    match /caixa_lancamentos/{docId} {
      allow read, delete: if isAdmin() || isLegacyAdmin();
      allow create, update: if (isAdmin() || isLegacyAdmin())
        && request.resource.data.tipo in ['venda', 'saida']
        && request.resource.data.data is string
        && request.resource.data.valor is number;
    }

    // --- TABELA DE DESPESA MENSAL (vendas.html) — só admin ---
    match /despesas_mensais/{docId} {
      allow read, delete: if isAdmin() || isLegacyAdmin();
      allow create, update: if (isAdmin() || isLegacyAdmin())
        && request.resource.data.mes is string
        && request.resource.data.desc is string
        && request.resource.data.valor is number;
    }

    // Bloqueia qualquer outra coleção
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
